# Rustorr settings for this server. tools/deploy.sh copies this file to
# ~/rustorr/.env on the first install and never overwrites it; edit it there
# and run `tools/deploy.sh <host> deploy` (or `restart`) to apply.
# Every RUSTORR_* option of `rustorr --help` can be set here.

# Host ports, and the host address they are published on (127.0.0.1 behind
# a reverse proxy on this server).
RUSTORR_BIND=0.0.0.0
RUSTORR_HTTP_PORT=8090
RUSTORR_HTTPS_PORT=8091
# Incoming peer connections, TCP and UDP; open it in the firewall.
RUSTORR_PEER_PORT=6881

# HTTP Basic authentication with the accounts in the data volume's accs.db.
# The first install creates an account and prints its password once.
RUSTORR_HTTP_AUTH=true

# Cache size to stay under.
RUSTORR_CACHE_SIZE=4GiB

# Built-in HTTPS with a self-signed certificate, and redirecting plain HTTP
# to it. For your own certificate: tools/deploy.sh <host> cert <chain> <key>.
#RUSTORR_SSL=true
#RUSTORR_FORCE_HTTPS=true

# Behind a reverse proxy: the proxy's addresses, so generated links use the
# host and scheme it forwards.
#RUSTORR_TRUSTED_PROXIES=172.16.0.0/12
